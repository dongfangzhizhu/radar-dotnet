# .NET 构建产物
bin/
obj/
*.user
*.suo
.vs/
.vscode/
.idea/
TestResults/
*.binlog

# 模型权重与导出产物（体积大，不入库；获取方式见 PLAN.md「模型产物管理」）
models/*.onnx
models/*.npz
models/*.safetensors
models/*.ort

# 测试数据（原始 NIfTI 不入库，统一从 damo-radar/data 软引用或下载脚本获取）
testdata/*.nii
testdata/*.nii.gz
testdata/*.zip
uploads/
results/

# Python 导出脚本虚拟环境
export/.venv/
export/.deps/
export/__pycache__/
__pycache__/
*.pyc

# 日志与临时文件
*.log
*.tmp
.DS_Store

# 黄金基线大文件（npy/npz/json 由 export/golden_dump.py 重建，不入库）
testdata/golden/*.npy
testdata/golden/*.npz
testdata/golden/*.json
testdata/golden/windows/
*.exit

# 例外：PNG 编码器的独立预言机（export/gen_png_ref.py 自产，与上游权重无关、< 1 KB）
# 必须入库 —— 否则新克隆上「编码器 vs Python zlib 参考」用例会静默跳过，编码器失去规范级校验
!testdata/golden/png_ref_5x3.json
!testdata/golden/png_ref_5x3.png

# 探针/临时产物与扩展 ignore
models/*.bin
models/*.json
testdata/_dicom_tmp/
testdata/_dicom_tmp_q*/
build_*.done
export/v1v2_compare*.txt
probe_*.txt

# 会话临时验证脚本与产物（.tmp_ 前缀）
.tmp_*
