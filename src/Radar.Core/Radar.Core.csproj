<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.30.0" />
    <!-- Gpu 包的 onnxruntime.dll 自带 CPU EP + CUDA EP（原生二选一，勿与 .OnnxRuntime/.DirectML 包并存）。
         CUDA EP 绑定 CUDA 12 + cuDNN 9：cudart/cublas/cudnn 运行时本机自备，
         OnnxSessionFactory 会自动把 CUDA/cuDNN bin 挂进进程 DLL 搜索路径 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.30.0" />
    <!-- DICOM 读取（CT 序列/多帧），DicomReader.cs 使用 -->
    <PackageReference Include="fo-dicom" Version="5.1.3" />
  </ItemGroup>

</Project>
